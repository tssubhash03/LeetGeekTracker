{
  "manifest_version": 2,
  "name": "LeetCode GitHub Integrator",
  "version": "1.0",
  "description": "Extract LeetCode/GFG problem data and save to GitHub, with Gemini AI explanations.",
  "permissions": [
    "storage",                              
    "tabs",                                
    "identity",                             
    "https://api.github.com/*",             
    "https://github.com/*",                 
    "http://localhost:4000/*",              
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "browser_action": {
    "default_popup": "popup/popup.html",
    "default_icon": "icon.png" 
  },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["content_scripts/extractor.js", "content_scripts/leetcodeScript.js"], 
      "run_at": "document_idle"
    },
    {
      "matches": ["https://practice.geeksforgeeks.org/problems/*"],
      "js": ["content_scripts/gfgScript.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icon.png"
  },
  "web_accessible_resources": [
    "oauth/github-callback.html" 
  ]
}